# Copy this file to .env and fill in all values before starting.
# NEVER commit .env to git.
#
# Generate strong passwords:
#   openssl rand -base64 32

# ── Required ──────────────────────────────────────────────────────────────────
DB_PASSWORD=<CHANGE_ME>
GRAFANA_PASSWORD=<CHANGE_ME>

# ── Docker Hub ────────────────────────────────────────────────────────────────
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TAG=main

# ── Optional ──────────────────────────────────────────────────────────────────
WORKSPACE=/workspace
RUNS_COUNT=3
CENSPROBE_IMPORT_INTERVAL_SEC=60

# Git identity used by solo/listener/client/control containers
CENSPROBE_GIT_EMAIL=censprobe-bot@example.com
CENSPROBE_GIT_NAME=censprobe-bot

# ipapi.is API key for ASN/geo lookups (leave empty to use free tier)
IPAPI_IS_KEY=

# Control baseline service
CONTROL_ID=control-de-01
CONTROL_COUNTRY=DE
