# Censprobe runtime configuration.
#
# Static config only — ports, passwords, tuning, API keys. Per-run
# parameters (--test-id, --session-id, etc.) are CLI arguments to
# `docker compose run`, not env vars.
#
# Local edits live in your working tree only — nothing is auto-pushed.

# ── Docker images (public Docker Hub) ─────────────────────────────────────────
# DOCKERHUB_USERNAME — Docker Hub account that publishes the images. Set
# to your own when forking, so `docker compose up` pulls your build.
DOCKERHUB_USERNAME=outtakes
DOCKERHUB_TAG=main

# ── Listener cred-server endpoint ─────────────────────────────────────────────
# CREDS_PORT is reused across runs (8443/tcp on the listener host) — it's
# durable config, not per-run, so it stays defined here. The listener
# generates CREDS_TOKEN and CREDS_CERT_SHA256 at startup and prints them
# inside the ready-to-paste client command (see per-run section above).
CREDS_PORT=8443

# ── Dashboard credentials (loopback-only services) ────────────────────────────
# Postgres binds inside the compose network; Grafana on 127.0.0.1:3000.
# Neither is exposed externally, but you MUST replace these placeholders
# before running the dashboard profile — `docker compose up` refuses to
# start with empty values, surfacing the missing override at boot rather
# than running with a known-public default password.
DB_PASSWORD=
GRAFANA_PASSWORD=

# Advanced: override the sync-api → Postgres URL only if you point it
# at an external database. Leave commented out to let docker-compose
# build it from DB_PASSWORD above.
# DATABASE_URL=postgresql+asyncpg://censprobe:${DB_PASSWORD}@postgres/censprobe

# ── Solo / dashboard tuning ───────────────────────────────────────────────────
# RUNS_COUNT — repeats per measurement (solo only).
# CENSPROBE_IMPORT_INTERVAL_SEC — sync-api scan interval over reports/.
RUNS_COUNT=3
CENSPROBE_IMPORT_INTERVAL_SEC=60

# ── Optional enrichment ───────────────────────────────────────────────────────
# ipapi.is API key for ASN/geo lookups (leave empty to use free tier).
# Used by solo and listener for server metadata; client never calls out.
IPAPI_IS_KEY=
