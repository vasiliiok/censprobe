# Censprobe runtime configuration.
#
# Single source of truth for every env var the system reads. Committed to
# the repo so a fresh clone runs without any setup. Two kinds of values:
#
#   1. Defaults — sensible for the maintainer's deployment, edit locally
#      to override (DOCKERHUB_USERNAME, DB_PASSWORD, RUNS_COUNT, etc.).
#   2. Per-run identifiers — left empty here; supply on the command line
#      when you invoke `docker compose up` (TEST_ID, SESSION_ID,
#      CREDS_TOKEN, ...). Setting them here would cause every run to
#      overwrite the same `reports/<TEST_ID>/` directory.
#
# Local edits live in your working tree only — nothing is auto-pushed.

# ── Docker images (public Docker Hub) ─────────────────────────────────────────
# DOCKERHUB_USERNAME — Docker Hub account that publishes the images. Set
# to your own when forking, so `docker compose up` pulls your build.
DOCKERHUB_USERNAME=outtakes
DOCKERHUB_TAG=main

# ── Per-run identifiers (override on the command line, NOT here) ──────────────
# Examples:
#   TEST_ID=selectel-spb-001 docker compose --profile solo up
#   TEST_ID=selectel-spb-001 SESSION_ID=client-home-rt-spb \
#     docker compose --profile listener up
TEST_ID=
SESSION_ID=
SERVER_HOST=

# ── Listener cred-server endpoint ─────────────────────────────────────────────
# CREDS_PORT is reused across runs (8443/tcp on the listener host).
# CREDS_TOKEN and CREDS_CERT_SHA256 are generated by the listener at
# startup and printed inside the ready-to-paste client command — they
# stay empty here.
CREDS_PORT=8443
CREDS_TOKEN=
CREDS_CERT_SHA256=

# ── Dashboard credentials (loopback-only services) ────────────────────────────
# Postgres binds inside the compose network; Grafana on 127.0.0.1:3000.
# Neither is exposed externally, so the defaults are safe.
DB_PASSWORD=1niJrSxwhgRFeu4Y0V7SkFwn6FLSuxCMuLUroLkGvs4=
GRAFANA_PASSWORD=admin

# Advanced: override the sync-api → Postgres URL only if you point it
# at an external database. Leave commented out to let docker-compose
# build it from DB_PASSWORD above.
# DATABASE_URL=postgresql+asyncpg://censprobe:${DB_PASSWORD}@postgres/censprobe

# ── Solo / dashboard tuning ───────────────────────────────────────────────────
# RUNS_COUNT — repeats per measurement (solo only).
# CENSPROBE_IMPORT_INTERVAL_SEC — sync-api scan interval over reports/.
RUNS_COUNT=3
CENSPROBE_IMPORT_INTERVAL_SEC=60

# ── Optional enrichment ───────────────────────────────────────────────────────
# ipapi.is API key for ASN/geo lookups (leave empty to use free tier).
# Used by solo and listener for server metadata; client never calls out.
IPAPI_IS_KEY=a5277864b4dc5573e3fe
