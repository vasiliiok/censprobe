# Censprobe runtime configuration.
#
# This file is committed to the repo and contains defaults that work
# out of the box. DB_PASSWORD / GRAFANA_PASSWORD protect localhost-only
# services (Postgres binds inside the compose network, Grafana on
# 127.0.0.1:3000), DOCKERHUB_USERNAME points at the maintainer's public
# images.
#
# Override locally by editing this file — your edits live in your
# working tree and are not auto-pushed anywhere. If you fork to publish
# your own reports, set DOCKERHUB_USERNAME to your account so
# `docker compose up` pulls images you control.

# ── Docker images (public) ────────────────────────────────────────────────────
DOCKERHUB_USERNAME=outtakes
DOCKERHUB_TAG=main

# ── Dashboard credentials (loopback-only services) ────────────────────────────
DB_PASSWORD=1niJrSxwhgRFeu4Y0V7SkFwn6FLSuxCMuLUroLkGvs4=
GRAFANA_PASSWORD=admin

# ── Solo / dashboard tuning ───────────────────────────────────────────────────
RUNS_COUNT=3
CENSPROBE_IMPORT_INTERVAL_SEC=60

# ipapi.is API key for ASN/geo lookups (leave empty to use free tier).
# Used by solo and listener for server metadata; client never calls out.
IPAPI_IS_KEY=a5277864b4dc5573e3fe
