# Censprobe runtime configuration.
#
# Static config only — ports, passwords, tuning, API keys. Per-run
# parameters (--test-id, --session-id, etc.) are CLI arguments to
# `docker compose run`, not env vars.
#
# Local edits live in your working tree only — nothing is auto-pushed.

# ── Docker images (public Docker Hub) ─────────────────────────────────────────
# DOCKERHUB_USERNAME — Docker Hub account that publishes the images. Set
# to your own when forking, so `docker compose up` pulls your build.
DOCKERHUB_USERNAME=outtakes
DOCKERHUB_TAG=main

# ── Listener cred-server endpoint ─────────────────────────────────────────────
# CREDS_PORT is reused across runs (8443/tcp on the listener host) — it's
# durable config, not per-run, so it stays defined here. The listener
# generates CREDS_TOKEN and CREDS_CERT_SHA256 at startup and prints them
# inside the ready-to-paste client command (see per-run section above).
CREDS_PORT=8443

# ── Sync endpoint ─────────────────────────────────────────────────────────────
# SYNC_PORT — TLS port the `sync serve` side binds on the source host
# (8444/tcp by default). Independent of CREDS_PORT so listener and sync
# can co-exist on the same host. Per-session token + cert fingerprint
# are generated on every `sync serve` startup and printed in the
# ready-to-paste pull command.
SYNC_PORT=8444

# ── Dashboard credentials (loopback-only services) ────────────────────────────
# Postgres binds inside the compose network; Grafana on 127.0.0.1:3000.
# Neither is exposed externally, so the committed defaults are safe for
# local dev: DB_PASSWORD is a random 32-char hex (regenerate locally if
# you exposed the port), GRAFANA_PASSWORD=admin matches the docker-compose
# header banner ("Open: http://localhost:3000 (admin/admin)"). Override
# them in your working tree before deploying anywhere reachable.
DB_PASSWORD=1a73be35206e1bd2b7f10febabd06dbd
GRAFANA_PASSWORD=admin

# Advanced: override the sync-api → Postgres URL only if you point it
# at an external database. Leave commented out to let docker-compose
# build it from DB_PASSWORD above.
# DATABASE_URL=postgresql+asyncpg://censprobe:${DB_PASSWORD}@postgres/censprobe

# SYNC_API_TOKEN — shared secret protecting /test-runs, /results,
# /protocols against unauthenticated reads. /health stays open so the
# docker healthcheck doesn't need to thread the token. The compose
# binding is 127.0.0.1:8080 (loopback only), so the token is
# defence-in-depth: prevents an unrelated process on the host (or a
# co-tenant container with host network access) from scraping data
# without operator consent. Empty string disables enforcement — only
# do that on a single-tenant dev box. Rotate by changing here and
# restarting the sync-api + any consumer that uses it (curl, scripts).
SYNC_API_TOKEN=fcb53d2c4ab38f1c0e8e5a32d7104f1a

# ── Solo / dashboard tuning ───────────────────────────────────────────────────
# RUNS_COUNT — repeats per measurement (solo only).
# CENSPROBE_IMPORT_INTERVAL_SEC — sync-api scan interval over reports/.
RUNS_COUNT=3
CENSPROBE_IMPORT_INTERVAL_SEC=60

# ── Optional enrichment ───────────────────────────────────────────────────────
# ipapi.is API key for ASN/geo lookups (leave empty to use free tier).
# Used by solo and listener for server metadata; client never calls out.
IPAPI_IS_KEY=
