    {
      "id": 4,
      "title": "Blocking methods used (distribution)",
      "description": "Pie of every distinct BlockingMethod attributed to a BLOCKED/THROTTLED result. Multi-server comparison: the same wedge appearing across hosts means the censor uses the same technique; divergence is a region/operator signal.",
      "type": "piechart",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT method, COUNT(*) AS count FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE (run.test_id IN (${test_id:singlequote})) AND method IS NOT NULL AND verdict IN ('BLOCKED','THROTTLED') GROUP BY method ORDER BY count DESC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "displayLabels": ["name", "percent"],
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 5,
      "title": "Method × Server (counts) — what each server sees",
      "description": "Cross-server heat: rows = blocking method, columns = test_id, cell = count of test_results with that (method, server). Lets the operator compare WHICH methods hit WHICH host — same method everywhere = global filter; method shows on one server only = host-specific issue.",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT method, run.test_id AS server, COUNT(*) AS count FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE (run.test_id IN (${test_id:singlequote})) AND method IS NOT NULL AND verdict IN ('BLOCKED','THROTTLED') GROUP BY method, run.test_id ORDER BY method, server",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "rawQuery": true,
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "server",
            "rowField": "method",
            "valueField": "count"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "continuous-BlPu"},
          "custom": {
            "cellOptions": {"type": "color-background"}
          },
          "noValue": "·"
        }
