    {
      "id": 1,
      "title": "TLS Integrity Score",
      "description": "% of TLS probes that completed cleanly. Lower = active SNI inspection or handshake interference.",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT test_id AS server, tls_integrity AS \"TLS Integrity\" FROM test_runs WHERE ('ALL' IN (${test_id:singlequote}) OR test_id IN (${test_id:singlequote})) AND tls_integrity IS NOT NULL ORDER BY tls_integrity ASC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "green",
                "value": 70
              }
            ]
          },
          "min": 0,
          "max": 100,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "TLS Verdict Distribution",
      "type": "piechart",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT verdict, COUNT(*) AS count FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE (run.test_id IN (${test_id:singlequote})) AND category = 'tls' GROUP BY verdict ORDER BY count DESC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "displayLabels": [
          "name",
          "percent"
        ],
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 3,
      "title": "SNI Inspection Detected",
      "description": "Targets where TLS to a Cloudflare IP with a censored SNI fails, but the same IP with neutral SNI succeeds. Smoking gun for SNI-based DPI.",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "WITH pairs AS (SELECT regexp_replace(test, '_sni_(blocked|neutral)$', '') AS pair_key, MAX(CASE WHEN subcategory = 'tls_sni_blocked' THEN verdict END) AS blocked_verdict, MAX(CASE WHEN subcategory = 'tls_sni_neutral' THEN verdict END) AS neutral_verdict, MAX(CASE WHEN subcategory = 'tls_sni_blocked' THEN target END) AS blocked_target FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE (run.test_id IN (${test_id:singlequote})) AND subcategory IN ('tls_sni_blocked','tls_sni_neutral') GROUP BY pair_key) SELECT pair_key AS target_pair, blocked_target, blocked_verdict, neutral_verdict, CASE WHEN blocked_verdict <> 'OK' AND neutral_verdict = 'OK' THEN 'SNI-INSPECTED' WHEN blocked_verdict = 'OK' AND neutral_verdict = 'OK' THEN 'clean' WHEN blocked_verdict <> 'OK' AND neutral_verdict <> 'OK' THEN 'IP-blocked' ELSE 'inconclusive' END AS diagnosis FROM pairs ORDER BY diagnosis, pair_key",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "diagnosis"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "clean": {
                        "color": "green"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "SNI-INSPECTED": {
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "IP-blocked": {
                        "color": "orange"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "inconclusive": {
                        "color": "blue"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
