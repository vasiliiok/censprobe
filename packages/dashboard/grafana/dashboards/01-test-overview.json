{
  "title": "01 \u2014 Test Overview",
  "uid": "censprobe-01",
  "tags": [
    "censprobe"
  ],
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "test_id",
        "label": "Test ID",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "DS_CENSPROBE_PG"
        },
        "query": "SELECT test_id FROM test_runs ORDER BY created_at DESC",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Drill-down dashboards",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Drill into a category:** [02 \u2014 Blocking Matrix](/d/censprobe-02?var-test_id=${test_id}) \u00b7 [03 \u2014 Telegram](/d/censprobe-03?var-test_id=${test_id}) \u00b7 [04 \u2014 Protocol Reachability](/d/censprobe-04?var-test_id=${test_id}) \u00b7 [05 \u2014 Technique Attribution](/d/censprobe-05?var-test_id=${test_id}) \u00b7 [06 \u2014 Compare Tests](/d/censprobe-06?var-test_id=${test_id}) \u00b7 [07 \u2014 Cloudflare & WARP](/d/censprobe-07?var-test_id=${test_id}) \u00b7 [08 \u2014 QUIC & ECH](/d/censprobe-08?var-test_id=${test_id}) \u00b7 [09 \u2014 DNS](/d/censprobe-09?var-test_id=${test_id}) \u00b7 [10 \u2014 TLS](/d/censprobe-10?var-test_id=${test_id}) \u00b7 [11 \u2014 Matrix Heatmap](/d/censprobe-11-matrix-heatmap?var-test_id=${test_id})"
      }
    },
    {
      "id": 1,
      "title": "Censorship Resistance Score",
      "description": "Overall score [0\u2013100]. Higher = less censored. Combines uplink quality, protocol reachability, and latency.",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 5,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT overall_score AS \"Score\" FROM test_runs WHERE test_id IN (${test_id:singlequote}) LIMIT 1",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "green",
                "value": 70
              }
            ]
          },
          "noValue": "\u2014"
        }
      }
    },
    {
      "id": 2,
      "title": "Score by Role",
      "description": "Entry = can clients reach me; Exit = can I reach the internet; Relay = basic TCP/UDP reachability",
      "type": "barchart",
      "gridPos": {
        "x": 5,
        "y": 3,
        "w": 7,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT 'Entry' AS role, entry_score AS score FROM test_runs WHERE test_id IN (${test_id:singlequote}) UNION ALL SELECT 'Exit', exit_score FROM test_runs WHERE test_id IN (${test_id:singlequote}) UNION ALL SELECT 'Relay', relay_score FROM test_runs WHERE test_id IN (${test_id:singlequote})",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "role"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "green",
                "value": 70
              }
            ]
          },
          "min": 0,
          "max": 100,
          "noValue": "\u2014"
        }
      }
    },
    {
      "id": 3,
      "title": "Server Info",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT 'AS' || (server_meta->'asn'->>'asn') AS asn, server_meta->'asn'->>'org' AS org, server_meta->'datacenter'->>'name' AS datacenter, server_meta->'location'->>'city' AS city, server_meta->'location'->>'country_code' AS country, server_meta->'asn'->>'route' AS route, distro, ipv6_available FROM test_runs WHERE test_id IN (${test_id:singlequote}) LIMIT 1",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "options": {
        "showHeader": true
      }
    },
