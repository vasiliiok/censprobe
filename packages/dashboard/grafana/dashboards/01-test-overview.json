{
  "__inputs": [
    {"name": "DS_CENSPROBE_PG", "label": "Censprobe Postgres", "type": "datasource", "pluginId": "postgres"}
  ],
  "title": "01 — Test Overview",
  "uid": "censprobe-01",
  "tags": ["censprobe"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-30d", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "test_id",
        "label": "Test ID",
        "type": "query",
        "datasource": {"type": "postgres", "uid": "${DS_CENSPROBE_PG}"},
        "query": "SELECT test_id FROM test_runs ORDER BY created_at DESC",
        "refresh": 2,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Overall VPN Suitability Score",
      "type": "gauge",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 8},
      "datasource": {"type": "postgres", "uid": "${DS_CENSPROBE_PG}"},
      "targets": [
        {
          "rawSql": "SELECT overall_score AS \"Overall Score\" FROM test_runs WHERE test_id = '$test_id' LIMIT 1",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 40},
              {"color": "green", "value": 70}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Scores by Role",
      "type": "barchart",
      "gridPos": {"x": 6, "y": 0, "w": 9, "h": 8},
      "datasource": {"type": "postgres", "uid": "${DS_CENSPROBE_PG}"},
      "targets": [
        {
          "rawSql": "SELECT 'Entry' AS role, entry_score AS score FROM test_runs WHERE test_id = '$test_id' UNION ALL SELECT 'Exit', exit_score FROM test_runs WHERE test_id = '$test_id' UNION ALL SELECT 'Relay', relay_score FROM test_runs WHERE test_id = '$test_id'",
          "format": "table"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "role"
      }
    },
    {
      "id": 3,
      "title": "Server Info",
      "type": "stat",
      "gridPos": {"x": 15, "y": 0, "w": 9, "h": 8},
      "datasource": {"type": "postgres", "uid": "${DS_CENSPROBE_PG}"},
      "targets": [
        {
          "rawSql": "SELECT asn, as_name, location, provider, distro, ipv4_masked FROM test_runs WHERE test_id = '$test_id' LIMIT 1",
          "format": "table"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "vertical"}
    },
    {
      "id": 4,
      "title": "DNS Integrity",
      "type": "gauge",
      "gridPos": {"x": 0, "y": 8, "w": 4, "h": 5},
      "datasource": {"type": "postgres", "uid": "${DS_CENSPROBE_PG}"},
      "targets": [
        {
          "rawSql": "SELECT dns_integrity FROM test_runs WHERE test_id = '$test_id' LIMIT 1",
          "format": "table"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "short"}}
    },
    {
      "id": 5,
      "title": "TLS Integrity",
      "type": "gauge",
      "gridPos": {"x": 4, "y": 8, "w": 4, "h": 5},
      "datasource": {"type": "postgres", "uid": "${DS_CENSPROBE_PG}"},
      "targets": [
        {
          "rawSql": "SELECT tls_integrity FROM test_runs WHERE test_id = '$test_id' LIMIT 1",
          "format": "table"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "short"}}
    },
    {
      "id": 6,
      "title": "Telegram Health",
      "type": "gauge",
      "gridPos": {"x": 8, "y": 8, "w": 4, "h": 5},
      "datasource": {"type": "postgres", "uid": "${DS_CENSPROBE_PG}"},
      "targets": [
        {
          "rawSql": "SELECT telegram_health FROM test_runs WHERE test_id = '$test_id' LIMIT 1",
          "format": "table"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "short"}}
    },
    {
      "id": 7,
      "title": "Throttling Detected",
      "type": "stat",
      "gridPos": {"x": 12, "y": 8, "w": 4, "h": 5},
      "datasource": {"type": "postgres", "uid": "${DS_CENSPROBE_PG}"},
      "targets": [
        {
          "rawSql": "SELECT CASE WHEN throttling_detected THEN 'YES ⚠' ELSE 'No ✓' END AS throttling FROM test_runs WHERE test_id = '$test_id' LIMIT 1",
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "title": "Detected Censorship Techniques",
      "type": "table",
      "gridPos": {"x": 0, "y": 13, "w": 24, "h": 5},
      "datasource": {"type": "postgres", "uid": "${DS_CENSPROBE_PG}"},
      "targets": [
        {
          "rawSql": "SELECT DISTINCT category, verdict, method, COUNT(*) AS count FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE run.test_id = '$test_id' AND verdict NOT IN ('OK','INCONCLUSIVE') GROUP BY category, verdict, method ORDER BY count DESC LIMIT 50",
          "format": "table"
        }
      ]
    },
    {
      "id": 9,
      "title": "Results by Category (Verdict Distribution)",
      "type": "piechart",
      "gridPos": {"x": 0, "y": 18, "w": 12, "h": 8},
      "datasource": {"type": "postgres", "uid": "${DS_CENSPROBE_PG}"},
      "targets": [
        {
          "rawSql": "SELECT category || ' / ' || verdict AS label, COUNT(*) AS count FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE run.test_id = '$test_id' GROUP BY category, verdict ORDER BY count DESC",
          "format": "table"
        }
      ]
    },
    {
      "id": 10,
      "title": "Recommended Protocols",
      "type": "text",
      "gridPos": {"x": 12, "y": 18, "w": 12, "h": 8},
      "datasource": {"type": "postgres", "uid": "${DS_CENSPROBE_PG}"},
      "targets": [
        {
          "rawSql": "SELECT recommended_protocols, detected_techniques FROM test_runs WHERE test_id = '$test_id' LIMIT 1",
          "format": "table"
        }
      ],
      "options": {"mode": "markdown"}
    }
  ]
}
