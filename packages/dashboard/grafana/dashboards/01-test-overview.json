    {
      "id": 10,
      "title": "Uplink Quality by Category",
      "description": "OK vs blocked test counts per category \u2014 shows which test domains/protocols are censored.",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT category, COUNT(*) FILTER (WHERE verdict = 'OK') AS ok, COUNT(*) FILTER (WHERE verdict IN ('BLOCKED','THROTTLED')) AS blocked FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE run.test_id IN (${test_id:singlequote}) GROUP BY category ORDER BY category",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "options": {
        "xField": "category",
        "stacking": {
          "mode": "normal"
        }
      }
