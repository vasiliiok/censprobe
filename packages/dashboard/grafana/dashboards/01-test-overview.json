    {
      "id": 7,
      "title": "Throttling Detected",
      "description": "Method-B SNI throttling probe: speedtest.selectel.ru with three SNI variants (correct / typo / trigger=1-googlevideo.com). YES (SNI) when the trigger-SNI bandwidth is <25% of the correct-SNI baseline. Only runs from RU/BY vantages.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT COALESCE(MAX(CASE WHEN tr.verdict = 'THROTTLED' THEN 2 WHEN tr.verdict = 'INCONCLUSIVE' THEN 1 WHEN tr.verdict = 'OK' THEN 0 END), -1)::int AS state FROM test_runs t LEFT JOIN test_results tr ON tr.test_run_id = t.id AND tr.category = 'throttling' WHERE t.test_id IN (${test_id:singlequote})",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2014",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "no data",
                  "color": "dark-gray",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "inconclusive",
                  "color": "yellow",
                  "index": 2
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "YES (SNI)",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Detected Censorship Techniques",
      "description": "Aggregated count of blocking verdicts per category and method.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT category, verdict, method, COUNT(*) AS count FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE run.test_id IN (${test_id:singlequote}) AND verdict IN ('BLOCKED','THROTTLED') GROUP BY category, verdict, method ORDER BY count DESC LIMIT 50",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
