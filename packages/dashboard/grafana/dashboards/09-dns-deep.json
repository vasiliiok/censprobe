            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "BLOCKED": {
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "DNS_BLOCKED": {
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "DOH_BLOCKED": {
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "DNS_POISONING": {
                        "color": "purple"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "INCONCLUSIVE": {
                        "color": "blue"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
