          "format": "table",
          "rawSql": "SELECT \n  COALESCE(test_runs.server_meta->'asn'->>'org', '\u2014 unknown \u2014') AS company,\n  ROUND(100.0 * SUM(CASE WHEN pr.verdict='OK' THEN 1 ELSE 0 END) /\n        NULLIF(COUNT(pr.id), 0), 1) AS \"% OK\",\n  COUNT(pr.id) AS sessions\nFROM test_runs\nJOIN listener_sessions ls ON ls.test_run_id = test_runs.id\nJOIN protocol_results pr ON pr.session_id = ls.id\nWHERE pr.protocol = ${var_protocol:singlequote}\n    AND (test_runs.server_meta->'asn'->>'org' IN (${var_company:singlequote}))\n    AND ('AS' || (test_runs.server_meta->'asn'->>'asn') IN (${var_asn:singlequote}))\n    AND (COALESCE(test_runs.server_meta->'datacenter'->>'name', 'No DC') IN (${var_datacenter:singlequote}))\n    AND (test_runs.server_meta->'location'->>'country_code' IN (${var_country:singlequote}))\n    AND (test_runs.test_id IN (${var_test_id:singlequote}))\n    AND (('Mobile' IN (${var_client_network:singlequote}) AND ls.is_mobile)\n         OR ('Whitelist' IN (${var_client_network:singlequote}) AND ls.is_whitelist)\n         OR ('Regular' IN (${var_client_network:singlequote}) AND NOT ls.is_mobile AND NOT ls.is_whitelist))\nGROUP BY company\nORDER BY \"% OK\" ASC NULLS FIRST",
