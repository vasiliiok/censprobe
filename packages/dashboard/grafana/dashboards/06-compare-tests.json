    {
      "id": 1,
      "title": "Average Scores by Group",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 16,
        "h": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT ${group_by:raw} AS group_name, AVG(test_runs.overall_score) AS overall, AVG(test_runs.entry_score) AS entry, AVG(test_runs.exit_score) AS exit, AVG(test_runs.relay_score) AS relay FROM test_runs \nWHERE \n    (test_runs.server_meta->'asn'->>'org' IN (${var_company:singlequote}))\n    AND ('AS' || (test_runs.server_meta->'asn'->>'asn') IN (${var_asn:singlequote}))\n    AND (COALESCE(test_runs.server_meta->'datacenter'->>'name', 'No DC') IN (${var_datacenter:singlequote}))\n    AND (test_runs.server_meta->'location'->>'country_code' IN (${var_country:singlequote}))\n    AND (test_runs.test_id IN (${var_test_id:singlequote}))\n GROUP BY 1 ORDER BY overall DESC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "options": {
        "xField": "group_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "green",
                "value": 70
              }
            ]
          },
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 2,
      "title": "Servers Matched",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 2,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(DISTINCT test_runs.test_id) AS matched FROM test_runs \nWHERE \n    (test_runs.server_meta->'asn'->>'org' IN (${var_company:singlequote}))\n    AND ('AS' || (test_runs.server_meta->'asn'->>'asn') IN (${var_asn:singlequote}))\n    AND (COALESCE(test_runs.server_meta->'datacenter'->>'name', 'No DC') IN (${var_datacenter:singlequote}))\n    AND (test_runs.server_meta->'location'->>'country_code' IN (${var_country:singlequote}))\n    AND (test_runs.test_id IN (${var_test_id:singlequote}))\n",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2014"
        }
      }
    },
    {
      "id": 5,
      "title": "Score by Group (most recent run)",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT ${group_by:raw} AS metric, AVG(test_runs.overall_score) AS value FROM test_runs WHERE (test_runs.server_meta->'asn'->>'org' IN (${var_company:singlequote})) AND ('AS' || (test_runs.server_meta->'asn'->>'asn') IN (${var_asn:singlequote})) AND (COALESCE(test_runs.server_meta->'datacenter'->>'name', 'No DC') IN (${var_datacenter:singlequote})) AND (test_runs.server_meta->'location'->>'country_code' IN (${var_country:singlequote})) AND (test_runs.test_id IN (${var_test_id:singlequote})) AND test_runs.overall_score IS NOT NULL GROUP BY 1 ORDER BY value ASC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
