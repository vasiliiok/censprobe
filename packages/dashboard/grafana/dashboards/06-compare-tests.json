          "rawSql": "SELECT test_runs.test_id AS server, test_runs.dns_integrity AS dns_integrity FROM test_runs WHERE \n    (test_runs.server_meta->'asn'->>'org' IN (${var_company:singlequote}))\n    AND ('AS' || (test_runs.server_meta->'asn'->>'asn') IN (${var_asn:singlequote}))\n    AND (COALESCE(test_runs.server_meta->'datacenter'->>'name', 'No DC') IN (${var_datacenter:singlequote}))\n    AND (test_runs.server_meta->'location'->>'country_code' IN (${var_country:singlequote}))\n    AND (test_runs.test_id IN (${var_test_id:singlequote}))\n    AND test_runs.dns_integrity IS NOT NULL ORDER BY test_runs.dns_integrity ASC LIMIT 20",
