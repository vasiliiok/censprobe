    },
    {
      "id": 6,
      "title": "Hysteria2 Protocol Reachability (from client sessions)",
      "description": "Hysteria2 uses QUIC (UDP 443 or configurable port). If UDP 443 is blocked, Hysteria2 is unreachable from those networks.",
      "type": "table",
      "gridPos": {
        "x": 10,
        "y": 18,
        "w": 14,
        "h": 7
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT ls.session_id, COALESCE(ls.client_meta->'asn'->>'org', '—') AS client_org, pr.verdict, pr.handshake_count, pr.data_transfer_ok, pr.avg_rtt_ms FROM protocol_results pr JOIN listener_sessions ls ON ls.id = pr.session_id JOIN test_runs tr ON tr.id = ls.test_run_id WHERE tr.test_id = ${test_id:sqlstring} AND pr.protocol = 'hysteria2' ORDER BY ls.session_id",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "verdict"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "BLOCKED": {
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "HANDSHAKE_ONLY": {
                        "color": "yellow"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
