    },
    {
      "id": 5,
      "title": "ECH Verdict Distribution",
      "type": "piechart",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 10,
        "h": 7
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT verdict, COUNT(*) AS count FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE run.test_id = ${test_id:sqlstring} AND category = 'tls' AND test LIKE '%_ech' GROUP BY verdict ORDER BY count DESC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
