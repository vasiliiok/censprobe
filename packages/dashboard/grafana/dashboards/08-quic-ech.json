{
  "title": "08 — QUIC & ECH",
  "uid": "censprobe-08",
  "tags": [
    "censprobe"
  ],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "test_id",
        "label": "Test ID",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "DS_CENSPROBE_PG"
        },
        "query": "SELECT test_id FROM test_runs ORDER BY created_at DESC",
        "refresh": 2,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Other dashboards",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Jump to:** [01 Overview](/d/censprobe-01) · [02 Blocking Matrix](/d/censprobe-02) · [03 Telegram](/d/censprobe-03) · [04 Protocol Reachability](/d/censprobe-04) · [05 Technique Attribution](/d/censprobe-05) · [06 Compare Tests](/d/censprobe-06) · [07 Cloudflare & WARP](/d/censprobe-07) · [08 QUIC & ECH](/d/censprobe-08) · [09 DNS](/d/censprobe-09) · [10 TLS](/d/censprobe-10)"
      }
    },
    {
      "id": 1,
      "title": "QUIC / UDP 443 Score",
      "description": "% of QUIC (UDP 443) probes returning OK. Score = 0 means TSPU is dropping all UDP 443 traffic (HTTP3, WARP MASQUE, and Hysteria2 all fail).",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 5,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE verdict = 'OK') / NULLIF(COUNT(*), 0)) AS \"QUIC Score\" FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE run.test_id = ${test_id:sqlstring} AND category = 'cloudflare' AND test LIKE 'cloudflare_quic%'",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "green",
                "value": 70
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "QUIC Test Results",
      "description": "Raw UDP 443 QUIC probe results. IP_DROPPED = TSPU silently drops UDP 443. OK = UDP 443 passes, HTTP3 and WARP MASQUE are viable.",
      "type": "table",
      "gridPos": {
        "x": 5,
        "y": 3,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT test, target, verdict, method, rtt_ms, notes FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE run.test_id = ${test_id:sqlstring} AND category = 'cloudflare' AND test LIKE 'cloudflare_quic%' ORDER BY test",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "verdict"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "IP_DROPPED": {
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "INCONCLUSIVE": {
                        "color": "blue"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "ECH Test Results",
      "description": "Encrypted Client Hello (ECH) probes. BLOCKED = on-path device intercepting TLS by SNI even when ECH is used. INCONCLUSIVE = curl or server doesn't support ECH.",
      "type": "table",
      "gridPos": {
        "x": 14,
        "y": 3,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT test, target, verdict, method, notes FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE run.test_id = ${test_id:sqlstring} AND category = 'tls' AND test LIKE '%_ech' ORDER BY test",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "verdict"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "BLOCKED": {
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "ANOMALY": {
                        "color": "yellow"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "INCONCLUSIVE": {
                        "color": "blue"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "title": "All QUIC-method Drops (any category)",
      "description": "Tests across all categories that detected QUIC being dropped (method = quic_dropped). Broader view than just the cloudflare probes.",
      "type": "table",
      "gridPos": {
