    "list": [
      {
        "name": "test_id",
        "label": "Test ID",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "DS_CENSPROBE_PG"
        },
        "query": "SELECT test_id FROM test_runs ORDER BY created_at DESC",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Other dashboards",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Jump to:** [01 Overview](/d/censprobe-01?var-test_id=${test_id}) \u00b7 [02 Blocking Matrix](/d/censprobe-02?var-test_id=${test_id}) \u00b7 [03 Telegram](/d/censprobe-03?var-test_id=${test_id}) \u00b7 [04 Protocol Reachability](/d/censprobe-04?var-test_id=${test_id}) \u00b7 [05 Technique Attribution](/d/censprobe-05?var-test_id=${test_id}) \u00b7 [06 Compare Tests](/d/censprobe-06?var-test_id=${test_id}) \u00b7 [07 Cloudflare & WARP](/d/censprobe-07?var-test_id=${test_id}) \u00b7 [08 QUIC & ECH](/d/censprobe-08?var-test_id=${test_id}) \u00b7 [09 DNS](/d/censprobe-09?var-test_id=${test_id}) \u00b7 [10 TLS](/d/censprobe-10?var-test_id=${test_id}) \u00b7 [11 Matrix Heatmap](/d/censprobe-11-matrix-heatmap?var-test_id=${test_id})"
      }
    },
    {
      "id": 1,
      "title": "Telegram Health Score",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT test_id AS server, telegram_health AS \"Telegram Health\" FROM test_runs WHERE ('ALL' IN (${test_id:singlequote}) OR test_id IN (${test_id:singlequote})) AND telegram_health IS NOT NULL ORDER BY telegram_health ASC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "green",
                "value": 70
              }
            ]
          },
          "min": 0,
          "max": 100,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
