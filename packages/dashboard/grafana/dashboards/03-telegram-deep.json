      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT verdict, COUNT(*) AS count FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE (run.test_id IN (${test_id:singlequote})) AND category = 'telegram' GROUP BY verdict",
          "format": "table",
          "refId": "A",
