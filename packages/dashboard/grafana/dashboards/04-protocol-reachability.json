{
  "title": "04 \u2014 Protocol Reachability",
  "uid": "censprobe-04",
  "tags": [
    "censprobe"
  ],
  "schemaVersion": 39,
  "version": 6,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "test_id",
        "label": "Test ID",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "DS_CENSPROBE_PG"
        },
        "query": "SELECT test_id FROM test_runs ORDER BY created_at DESC",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Other dashboards",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Jump to:** [01 Overview](/d/censprobe-01?var-test_id=${test_id}) \u00b7 [02 Blocking Matrix](/d/censprobe-02?var-test_id=${test_id}) \u00b7 [03 Telegram](/d/censprobe-03?var-test_id=${test_id}) \u00b7 [04 Protocol Reachability](/d/censprobe-04?var-test_id=${test_id}) \u00b7 [05 Technique Attribution](/d/censprobe-05?var-test_id=${test_id}) \u00b7 [06 Compare Tests](/d/censprobe-06?var-test_id=${test_id}) \u00b7 [07 Cloudflare & WARP](/d/censprobe-07?var-test_id=${test_id}) \u00b7 [08 QUIC & ECH](/d/censprobe-08?var-test_id=${test_id}) \u00b7 [09 DNS](/d/censprobe-09?var-test_id=${test_id}) \u00b7 [10 TLS](/d/censprobe-10?var-test_id=${test_id}) \u00b7 [11 Matrix Heatmap](/d/censprobe-11-matrix-heatmap?var-test_id=${test_id})"
      }
    },
    {
      "id": 1,
      "title": "Protocol \u00d7 Session Reachability Matrix",
      "description": "Rows = client sessions, shows per-protocol connectivity verdict from each client network.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT tr.test_id AS server, ls.session_id, COALESCE(ls.client_meta->'asn'->>'org', '\u2014') AS client_org, pr.protocol, pr.verdict, pr.handshake_count, pr.data_transfer_ok, COALESCE(pr.avg_throughput_mbps, pr.client_avg_throughput_mbps) AS avg_throughput_mbps, pr.throughput_throttled, pr.note FROM protocol_results pr JOIN listener_sessions ls ON ls.id = pr.session_id JOIN test_runs tr ON tr.id = ls.test_run_id WHERE (tr.test_id IN (${test_id:singlequote})) ORDER BY ls.session_id, pr.protocol",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "verdict"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green",
                        "text": "\u2713 CONNECTED"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "BLOCKED": {
                        "color": "red",
                        "text": "\u2717 BLOCKED"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "HANDSHAKE_ONLY": {
                        "color": "yellow",
                        "text": "~ HS ONLY"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "INCONCLUSIVE": {
                        "color": "blue",
                        "text": "?"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg_throughput_mbps"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Throughput (Mbps)"
              },
              {
                "id": "unit",
                "value": "Mbits"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "noValue",
                "value": "\u2014"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "transparent", "value": null},
                    {"color": "red", "value": 0},
                    {"color": "yellow", "value": 5},
                    {"color": "green", "value": 50}
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "throughput_throttled"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Throttled"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "color": "red",
                        "text": "throttled"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "false": {
                        "color": "transparent",
                        "text": ""
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "note"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Diagnostic"
              },
              {
                "id": "noValue",
                "value": "\u2014"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              },
              {
                "id": "custom.width",
                "value": 520
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Protocol Success Rate (across all sessions)",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT pr.protocol, COUNT(*) FILTER (WHERE pr.verdict = 'OK') AS connected, COUNT(*) FILTER (WHERE pr.verdict = 'HANDSHAKE_ONLY') AS handshake_only, COUNT(*) FILTER (WHERE pr.verdict = 'BLOCKED') AS blocked FROM protocol_results pr JOIN listener_sessions ls ON ls.id = pr.session_id JOIN test_runs tr ON tr.id = ls.test_run_id WHERE (tr.test_id IN (${test_id:singlequote})) GROUP BY pr.protocol ORDER BY connected DESC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "options": {
        "xField": "protocol",
        "stacking": {
          "mode": "normal"
        }
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "connected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "handshake_only"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "blocked"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "Listener Sessions",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT tr.test_id AS server, ls.session_id, ls.started_at, ls.duration_sec, ls.client_connected, COALESCE(ls.client_meta->'asn'->>'org', '\u2014') AS client_org, COALESCE(ls.client_meta->'location'->>'city', '\u2014') AS city, CASE WHEN ls.client_meta->>'is_mobile' = 'true' THEN 'mobile' WHEN ls.client_meta->>'is_datacenter' = 'true' THEN 'datacenter' ELSE 'residential' END AS client_type, COUNT(pr.id) AS protocols, COUNT(*) FILTER (WHERE pr.verdict='OK') AS ok_protocols FROM listener_sessions ls LEFT JOIN protocol_results pr ON pr.session_id = ls.id JOIN test_runs tr ON tr.id = ls.test_run_id WHERE (tr.test_id IN (${test_id:singlequote})) GROUP BY tr.test_id, ls.id, ls.session_id, ls.started_at, ls.duration_sec, ls.client_connected, ls.client_meta ORDER BY tr.test_id, ls.started_at DESC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Throughput by protocol (per session, Mbps)",
      "description": "Sustained throughput per protocol. Prefers the client-measured number (POSTed in /stop body) and falls back to the listener-side measurement when the client predates the body upload. MTProto protocols don't expose an echo and stay absent. Throttled rows are hidden (the bar would be 0); see the matrix panel above for the throttled flag.",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 18,
        "h": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT (COALESCE(ls.client_meta->'asn'->>'org', '\u2014') || ' / ' || ls.session_id) AS session, pr.protocol, COALESCE(pr.avg_throughput_mbps, pr.client_avg_throughput_mbps) AS mbps FROM protocol_results pr JOIN listener_sessions ls ON ls.id = pr.session_id JOIN test_runs tr ON tr.id = ls.test_run_id WHERE (tr.test_id IN (${test_id:singlequote})) AND COALESCE(pr.avg_throughput_mbps, pr.client_avg_throughput_mbps) IS NOT NULL ORDER BY session, pr.protocol",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          },
          "unit": "Mbits",
          "decimals": 1,
          "noValue": "\u2014"
        }
      },
      "options": {
        "orientation": "horizontal",
        "xField": "session",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "stacking": "none",
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Median throughput (across all OK sessions, by protocol)",
      "description": "Per-protocol median of throughput (client-measured preferred, listener-measured fallback) over every session that reached data_ok. Useful for cross-protocol comparison without per-session noise.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 23,
        "w": 6,
        "h": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT pr.protocol, PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY COALESCE(pr.avg_throughput_mbps, pr.client_avg_throughput_mbps)) AS median_mbps FROM protocol_results pr JOIN listener_sessions ls ON ls.id = pr.session_id JOIN test_runs tr ON tr.id = ls.test_run_id WHERE (tr.test_id IN (${test_id:singlequote})) AND COALESCE(pr.avg_throughput_mbps, pr.client_avg_throughput_mbps) IS NOT NULL GROUP BY pr.protocol ORDER BY median_mbps DESC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          },
          "unit": "Mbits",
          "decimals": 1,
          "noValue": "\u2014"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^median_mbps$/",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    }
  ]
}
