    {
      "id": 6,
      "title": "Method \u00d7 Category distribution (pie)",
      "description": "Per-category share of each censorship method. DNS-row dominated by dns_poisoning + dns_blocked_nxdomain \u2014 shows what the censor uses against name resolution; TLS-row dominated by tcp_rst_after_tls_ch + tls_handshake_failure \u2014 shows post-handshake intervention.",
      "type": "piechart",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT (category || ' / ' || method) AS technique, COUNT(*) AS count FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE (run.test_id IN (${test_id:singlequote})) AND method IS NOT NULL AND verdict IN ('BLOCKED','THROTTLED') GROUP BY category, method ORDER BY count DESC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "displayLabels": ["name", "percent"],
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": true
        }
      }
