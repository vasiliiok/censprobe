    {
      "id": 1,
      "title": "Censorship Techniques \u2014 Count by Type",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT method, COUNT(*) AS detections FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE run.test_id IN (${test_id:singlequote}) AND method IS NOT NULL GROUP BY method ORDER BY detections DESC",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "options": {
        "xField": "method"
      }
