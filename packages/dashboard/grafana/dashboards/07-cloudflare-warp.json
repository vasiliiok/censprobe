    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "test_id",
        "label": "Test ID",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "DS_CENSPROBE_PG"
        },
        "query": "SELECT test_id FROM test_runs ORDER BY created_at DESC",
        "refresh": 2,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Other dashboards",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Jump to:** [01 Overview](/d/censprobe-01) · [02 Blocking Matrix](/d/censprobe-02) · [03 Telegram](/d/censprobe-03) · [04 Protocol Reachability](/d/censprobe-04) · [05 Technique Attribution](/d/censprobe-05) · [06 Compare Tests](/d/censprobe-06) · [07 Cloudflare & WARP](/d/censprobe-07) · [08 QUIC & ECH](/d/censprobe-08) · [09 DNS](/d/censprobe-09) · [10 TLS](/d/censprobe-10)"
      }
    },
    {
      "id": 1,
      "title": "Cloudflare Reachability Score (excl. QUIC)",
      "description": "% of Cloudflare tests returning OK, excluding QUIC/HTTP3 probes (those live on the QUIC dashboard). Reflects WARP control, MASQUE/WG UDP fallbacks, and CF-hosted HTTP.",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 5,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE verdict = 'OK') / NULLIF(COUNT(*), 0)) AS \"Score\" FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE run.test_id = ${test_id:sqlstring} AND category = 'cloudflare' AND test NOT LIKE 'cloudflare_quic%'",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "green",
                "value": 70
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "WARP Control Plane (TCP 443)",
      "description": "TCP reachability to WARP registration and orchestration endpoints. Required for WARP to enroll and activate. (QUIC/HTTP3 path lives on the QUIC & ECH dashboard.)",
      "type": "table",
      "gridPos": {
        "x": 5,
        "y": 3,
        "w": 19,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "DS_CENSPROBE_PG"
      },
      "targets": [
        {
          "rawSql": "SELECT test, target, verdict, rtt_ms FROM test_results tr JOIN test_runs run ON run.id = tr.test_run_id WHERE run.test_id = ${test_id:sqlstring} AND category = 'cloudflare' AND test IN ('cloudflare_warp_engage_api','cloudflare_warp_connectivity_check','cloudflare_warp_zt_orchestration','cloudflare_warp_masque_anycast_tcp','cloudflare_warp_wg_anycast_tcp') ORDER BY test",
          "format": "table",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "DS_CENSPROBE_PG"
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "verdict"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "BLOCKED": {
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "REFUSED": {
                        "color": "orange"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "INCONCLUSIVE": {
                        "color": "blue"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
