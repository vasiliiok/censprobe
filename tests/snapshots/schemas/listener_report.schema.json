            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "network": {
          "anyOf": [
            {
              "type": "string"
            },
            {
